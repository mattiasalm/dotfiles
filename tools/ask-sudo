#!/bin/zsh -e

# Check if sudo credentials are already cached and valid
if sudo -n true 2>/dev/null; then
    color-print green "Administrator credentials already available"
else
    # Ask for the administrator password only if needed
    echo
    color-print cyan "Administrator password:"
    sudo -v
fi

# Keep-alive: update existing `sudo` time stamp until the calling process has finished
# The calling process is watched, since this script itself ends right away
_CALLER_PID=$PPID

# One keep-alive per calling process, its PID is stored to avoid starting another one
_KEEPER_FILE="${TMPDIR:-/tmp}/dotfiles_sudo_$_CALLER_PID"
if [ -f "$_KEEPER_FILE" ] && kill -0 "$(<$_KEEPER_FILE)" 2>/dev/null; then
    exit 0
fi

keep_sudo_alive() {
    while kill -0 "$_CALLER_PID" 2>/dev/null; do
        sudo -n true 2>/dev/null || break
        sleep 60
    done
    rm -f "$_KEEPER_FILE"
}

# Run keep-alive in background, detached from this script
keep_sudo_alive &!
echo $! > "$_KEEPER_FILE"
