#!/bin/zsh -e

# Check if sudo credentials are already cached and valid
if sudo -n true 2>/dev/null; then
    color-print green "Administrator credentials already available"
else
    # Ask for the administrator password only if needed
    echo
    color-print cyan "Administrator password:"
    sudo -v
fi

# Keep-alive: update existing `sudo` time stamp until parent process finished
# Store the PID for cleanup
_SUDO_PID_FILE="/tmp/dotfiles_sudo_$$"
echo $$ > "$_SUDO_PID_FILE"

keep_sudo_alive() {
    local parent_pid=$1
    while kill -0 "$parent_pid" 2>/dev/null; do
        sudo -n true 2>/dev/null || break
        sleep 180
    done
    rm -f "$_SUDO_PID_FILE" 2>/dev/null
}

# Run keep-alive in background with proper cleanup
keep_sudo_alive $$ &
echo $! > "${_SUDO_PID_FILE}.keeper"
