#!/bin/zsh -e

_FILE_PATH="$1"

# Validate input
if [ -z "$_FILE_PATH" ]; then
    color-print red "Usage: read-symlink <file_path>"
    exit 1
fi

# Use built-in readlink if available, otherwise fallback
if command -v readlink >/dev/null 2>&1; then
    # Use readlink for reliable symlink resolution
    if [ -L "$_FILE_PATH" ]; then
        readlink "$_FILE_PATH"
    else
        echo "$_FILE_PATH"
    fi
else
    # Fallback for systems without readlink
    if [ -L "$_FILE_PATH" ] && [ -e "$_FILE_PATH" ]; then
        # More robust parsing
        ls -l "$_FILE_PATH" | sed 's/.* -> //'
    else
        echo "$_FILE_PATH"
    fi
fi