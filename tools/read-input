#!/bin/zsh

# Simple text input utility
# Usage: read-input <output_file> <prompt_text> [default_value]

_RESULT_FILE=$1
_PROMPT_TEXT=$2
_DEFAULT_VALUE=$3

# Check if output file is provided
if [ -z "$_RESULT_FILE" ]; then
	color-print red "No output file provided"
	exit 1
fi

# Check if prompt text is provided
if [ -z "$_PROMPT_TEXT" ]; then
	_PROMPT_TEXT="Enter value"
fi

# Create output file
touch "$_RESULT_FILE"

# Display prompt with default value if provided
if [ -n "$_DEFAULT_VALUE" ]; then
	color-print cyan "$_PROMPT_TEXT: "
	color-print grey "(press Enter to use default: $_DEFAULT_VALUE)"
else
	color-print cyan "$_PROMPT_TEXT: "
fi

# Read user input
read -r _USER_INPUT

# Use default if no input provided
if [ -z "$_USER_INPUT" ] && [ -n "$_DEFAULT_VALUE" ]; then
	_USER_INPUT="$_DEFAULT_VALUE"
fi

# Write result to file
echo "$_USER_INPUT" > "$_RESULT_FILE"